export const requestEntry = catchAsync(async (req, res, next) => {
  const { name, visitorType, phone, vehicleNo, tower, flatNo } = req.body;
  
  const photoUrl = req.file ? req.file.path : '';

  const residentQuery = { role: 'RESIDENT', flatNo, isActive: true };
  if (tower) residentQuery.tower = tower;
  const resident = await User.findOne(residentQuery);

  const newVisitor = await Visitor.create({
    name, visitorType, phone, vehicleNo, tower, flatNo,
    photoUrl,
    residentId: resident ? resident._id : null,
    guardId: req.user._id
  });

  if (resident && resident.fcmToken) {
    try {
      await getMessaging().send({
        token: resident.fcmToken,
        data: { 
          type: 'GATE_APPROVAL', 
          visitorId: newVisitor._id.toString(),
          visitorName: name,
          visitorType: visitorType,
          vehicleNo: vehicleNo || 'N/A',
          photoUrl: photoUrl 
        },
        android: { priority: 'high' },
        apns: { payload: { aps: { 'content-available': 1 } } }
      });
    } catch (error) {
      console.error("❌ Notification Error:", error.message);
    }
  }

  res.status(201).json({
    status: 'success',
    message: resident ? 'Approval request sent to resident.' : 'Resident not registered, contact manually.',
    data: { visitor: newVisitor, hasResidentApp: !!resident, residentPhone: resident?.phone }
  });
});

export const respondToEntry = catchAsync(async (req, res, next) => {
  const { status } = req.body; 
  const visitorId = req.params.id;

  const visitor = await Visitor.findById(visitorId).populate('guardId');
  if (!visitor) return next(new AppError('Visitor not found', 404));

  if (visitor.status !== 'Pending') {
    return next(new AppError('This request has already been processed.', 400));
  }

  visitor.status = status;
  if (status === 'Approved') visitor.entryTime = Date.now();
  await visitor.save();

  if (visitor.guardId && visitor.guardId.fcmToken) {
    try {
      await getMessaging().send({
        token: visitor.guardId.fcmToken,
        notification: {
          title: `Entry ${status} ✅`,
          body: `Flat ${visitor.flatNo} has ${status.toLowerCase()} entry for ${visitor.name}.`
        },
        data: { type: 'GATE_UPDATE', visitorId: visitor._id.toString() },
        android: {
          priority: 'high',
          notification: { sound: 'default' }
        },
        apns: { payload: { aps: { sound: 'default' } } }
      });
      console.log(`✅ Direct notification sent to Guard FCM: ${visitor.guardId.fcmToken}`);
    } catch (error) {
      console.error("❌ Direct Firebase Notification Error (Guard):", error.message);
    }
  }

  res.status(200).json({ status: 'success', data: { visitor } });
});

