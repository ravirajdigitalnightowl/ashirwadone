export const getActiveVisitors = catchAsync(async (req, res, next) => {
  const { timeRange } = req.query; 
  let query = {};

  if (timeRange) {
    const now = new Date();
    const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

    if (timeRange === 'Today') {
      query.updatedAt = { $gte: new Date(now.setHours(0, 0, 0, 0)) };
    } 
    else if (timeRange === 'This Week') { 
      const startDate = new Date(); startDate.setDate(now.getDate() - 7); 
      query.updatedAt = { $gte: startDate }; 
    } 
    else if (timeRange === 'This Month') { 
      const startDate = new Date(now.getFullYear(), now.getMonth(), 1); 
      query.updatedAt = { $gte: startDate }; 
    } 
    else if (months.includes(timeRange)) {
      const monthIndex = months.indexOf(timeRange);
      const startDate = new Date(now.getFullYear(), monthIndex, 1);
      const endDate = new Date(now.getFullYear(), monthIndex + 1, 1);
      query.updatedAt = { $gte: startDate, $lt: endDate };
    }
  } else {
    // Default to Today if no timeRange provided at all (safety fallback)
    const startOfToday = new Date(new Date().setHours(0, 0, 0, 0));
    query.updatedAt = { $gte: startOfToday };
  }

  const visitors = await Visitor.find(query).sort('-updatedAt'); 

  res.status(200).json({ 
    status: 'success', 
    results: visitors.length,
    data: { visitors } 
  });
});

