export const login = catchAsync(async (req, res, next) => {
  const { email, password } = req.body;

  if (!email || !password) return next(new AppError('Please provide email and password!', 400));

  const user = await User.findOne({ email }).select('+password');

  if (!user || !(await user.correctPassword(password, user.password))) {
    return next(new AppError('Incorrect email or password', 401));
  }

  if (user.isActive === false) return next(new AppError('Your account has been suspended. Contact Admin.', 403));

  // 🔥 NAYA UPDATE: Naye device se login hone par session version +1 kar do
  // Agar pehle se sessionVersion nahi hai, toh (1 + 1) yani 2 set ho jayega.
  user.sessionVersion = (user.sessionVersion || 1) + 1;
  await user.save({ validateBeforeSave: false });

  createSendToken(user, 200, res);
});

export const updateFCMToken = catchAsync(async (req, res, next) => {
  const { fcmToken } = req.body;

  // 🔥 UPDATE: '!fcmToken' ki jagah '=== undefined' kiya. Ab 'null' value allowed hai.
  if (fcmToken === undefined) {
    return next(new AppError('Please provide an FCM token', 400));
  }

  // Logged-in user ka token update ya clear kar rahe hain
  const user = await User.findByIdAndUpdate(
    req.user._id, 
    { fcmToken }, 
    { new: true, runValidators: false }
  );

  res.status(200).json({
    status: 'success',
    message: fcmToken ? 'FCM Token updated successfully' : 'FCM Token cleared successfully',
    data: {
      fcmToken: user.fcmToken
    }
  });
});


