export const getAllWorkers = catchAsync(async (req, res, next) => {
  const { search, department } = req.query;
  
  let query = { role: 'WORKER' };

  // Search logic (Name, Email, Phone)
  if (search) {
    query.$or = [
      { name: { $regex: search, $options: 'i' } },
      { email: { $regex: search, $options: 'i' } },
      { phone: { $regex: search, $options: 'i' } }
    ];
  }

  // Department filter
  if (department && department !== 'All') {
    query.department = department;
  }

  const workers = await User.find(query).sort('-createdAt');

  res.status(200).json({
    status: 'success',
    results: workers.length,
    data: { workers }
  });
});

export const toggleUserStatus = catchAsync(async (req, res, next) => {
  const user = await User.findById(req.params.id);

  if (!user) return next(new AppError('No user found with that ID', 404));
  if (user.role === 'ADMIN') return next(new AppError('Cannot change status of an Admin account', 403));

  user.isActive = !user.isActive;
  await user.save({ validateBeforeSave: false });

  res.status(200).json({
    status: 'success',
    message: `User account has been ${user.isActive ? 'activated' : 'suspended'}`,
    data: { isActive: user.isActive }
  });
});

