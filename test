export const createUser = catchAsync(async (req, res, next) => {
  // 🔥 UPDATE: Body se password aur tower dono destructure kar rahe hain
  const { name, email, phone, role, tower, flatNo, department, password } = req.body;

  if (!['RESIDENT', 'WORKER'].includes(role)) {
    return next(new AppError('Invalid role specified. Can only create RESIDENT or WORKER.', 400));
  }

  if (!password) {
    return next(new AppError('Please provide a password for the new user.', 400));
  }

  // 🔥 UPDATE: Admin ka diya hua password use kiya aur tower field add kiya
  const newUser = await User.create({
    name, 
    email, 
    phone, 
    role,
    password: password, 
    tower: role === 'RESIDENT' ? tower : undefined, // 🔥 Added Tower
    flatNo: role === 'RESIDENT' ? flatNo : undefined,
    department: role === 'WORKER' ? department : undefined
  });

  console.log('\n=============================================');
  console.log(`🔐 NEW ${role} CREATED MANUALLY BY ADMIN`);
  console.log(`👤 Name: ${newUser.name}`);
  console.log(`📧 Email: ${newUser.email}`);
  console.log(`📞 Phone: ${newUser.phone}`);
  if (role === 'RESIDENT') console.log(`🏢 Tower & Flat: ${tower} - ${flatNo}`);
  console.log(`🔑 Assigned Password: ${password}`);
  console.log('=============================================\n');

  res.status(201).json({
    status: 'success',
    message: `${role} created successfully. Please share the credentials with the user.`,
    data: {
      user: {
        _id: newUser._id,
        name: newUser.name,
        role: newUser.role
      }
    }
  });
});

