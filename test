import createSendToken from '../utils/createToken.js';

export const setupAdmin = catchAsync(async (req, res, next) => {
  const adminExists = await User.findOne({ role: 'ADMIN' });
  if (adminExists) return next(new AppError('Admin already exists! Setup route is now locked.', 403));

  const { name, email, phone, password } = req.body;
  const admin = await User.create({ name, email, phone, password, role: 'ADMIN' });

  createSendToken(admin, 201, res);
});


export const register = catchAsync(async (req, res, next) => {
  const { name, email, phone, password, role, flatNo, department } = req.body;

  // Security check: Is public route se koi ADMIN na ban paye
  if (role === 'ADMIN') {
    return next(new AppError('Admin account cannot be created via this route. Use /admin/setup instead.', 400));
  }

  // Naya user create karna (Mongoose schema automatic flatNo/department check kar lega)
  const newUser = await User.create({
    name,
    email,
    phone,
    password,
    role,
    flatNo,
    department
  });

  createSendToken(newUser, 201, res);
});

