import Ticket from '../models/Ticket.js';
import User from '../models/User.js';
import catchAsync from '../utils/catchAsync.js';
import AppError from '../utils/AppError.js';
import { notificationQueue } from '../services/notificationQueue.js';

export const createTicket = catchAsync(async (req, res, next) => {
  const { title, category, description } = req.body;
  
  const mediaUrl = req.file ? req.file.path : '';

  const newTicket = await Ticket.create({
    title,
    category,
    description,
    mediaUrl, 
    createdBy: req.user._id,
    timeline: [{
      title: 'Complaint Registered',
      notes: 'Ticket successfully created by resident.'
    }]
  });

  const admins = await User.find({ role: 'ADMIN' });
  
  admins.forEach(admin => {
    if (admin.fcmToken) {
      const towerInfo = req.user.tower ? `Tower ${req.user.tower}, ` : '';
      
      notificationQueue.add('sendToAdmin', {
        fcmToken: admin.fcmToken,
        title: 'New Complaint Raised 🚨',
        body: `${category} issue reported by ${towerInfo}Flat ${req.user.flatNo}`,
        data: { type: 'NEW_COMPLAINT', ticketId: newTicket._id.toString() } 
      });
    }
  });

  res.status(201).json({
    status: 'success',
    data: { ticket: newTicket }
  });
});

// 🔥 UPDATE: Resident tickets filter updated (Pagination removed, Specific Month added)
export const getMyTickets = catchAsync(async (req, res, next) => {
  const { status, timeRange } = req.query;
  let query = { createdBy: req.user._id };

  if (status && status !== 'All') query.status = status;

  if (timeRange) {
    const now = new Date();
    const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

    if (timeRange === 'Today') {
      query.createdAt = { $gte: new Date(now.setHours(0, 0, 0, 0)) };
    } 
    else if (timeRange === 'This Week') { 
      const startDate = new Date(); 
      startDate.setDate(now.getDate() - 7); 
      query.createdAt = { $gte: startDate }; 
    } 
    else if (timeRange === 'This Month') { 
      // Current month ka 1st day
      const startDate = new Date(now.getFullYear(), now.getMonth(), 1); 
      query.createdAt = { $gte: startDate }; 
    } 
    else if (months.includes(timeRange)) {
      // Specific Month logic (e.g., 'August')
      const monthIndex = months.indexOf(timeRange);
      const startDate = new Date(now.getFullYear(), monthIndex, 1);
      const endDate = new Date(now.getFullYear(), monthIndex + 1, 1); // Agle mahine ki 1st date
      query.createdAt = { $gte: startDate, $lt: endDate };
    }
  }

  // Pagination removed, sidha sort karke bhej do
  const tickets = await Ticket.find(query).sort('-createdAt');

  res.status(200).json({
    status: 'success',
    results: tickets.length,
    data: { tickets }
  });
});


