export const getDashboardStats = catchAsync(async (req, res, next) => {
  // Ticket stats
  const ticketStats = await Ticket.aggregate([{ $group: { _id: '$status', count: { $sum: 1 } } }]);
  
  // Naya Data Fetching
  const totalResidents = await User.countDocuments({ role: 'RESIDENT' });
  const totalWorkers = await User.countDocuments({ role: 'WORKER' });
  const activeVisitors = await Visitor.countDocuments({ status: { $in: ['Approved', 'Entered'] } });

  const formattedStats = { 
    pending: 0, inProgress: 0, resolved: 0,
    totalResidents, 
    totalWorkers, 
    activeVisitors 
  };

  ticketStats.forEach(stat => {
    if (stat._id === 'Pending') formattedStats.pending = stat.count;
    if (stat._id === 'In-Progress') formattedStats.inProgress = stat.count;
    if (stat._id === 'Resolved') formattedStats.resolved = stat.count;
  });

  res.status(200).json({ status: 'success', data: formattedStats });
});


