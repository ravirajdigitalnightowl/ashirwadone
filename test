export const updateUser = catchAsync(async (req, res, next) => {
  // 🔥 UPDATE: tower ko destructure kiya
  const { name, email, phone, tower, flatNo, department, password } = req.body;
  const user = await User.findById(req.params.id);

  if (!user) return next(new AppError('User not found', 404));

  // Jo fields request mein aayengi, sirf unhe update karenge
  if (name) user.name = name;
  if (email) user.email = email;
  if (phone) user.phone = phone;
  
  // 🔥 UPDATE: Tower aur FlatNo update logic (sirf residents ke liye)
  if (tower && user.role === 'RESIDENT') user.tower = tower;
  if (flatNo && user.role === 'RESIDENT') user.flatNo = flatNo;
  
  if (department && user.role === 'WORKER') user.department = department;
  
  // Agar Admin ne password reset kiya hai
  if (password) {
    user.password = password; // Mongoose pre-save hook isko automatically hash kar dega
    console.log(`\n🔑 PASSWORD RESET FOR ${user.name}: ${password}\n`);
  }

  await user.save();

  res.status(200).json({
    status: 'success',
    message: 'User details updated successfully',
    data: { user }
  });
});



import User from '../models/User.js';
import catchAsync from '../utils/catchAsync.js';
