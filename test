// src/services/notificationQueue.js
import { Queue, Worker } from 'bullmq';
import IORedis from 'ioredis';
import '../config/firebase.js'; // Tumhara Firebase initialize karne wali file 
import { getMessaging } from 'firebase-admin/messaging'; // 🔥 NAYA IMPORT: Modular Firebase Messaging ke liye

// Redis Connection URL (Render Environment variable se ya local fallback)
const redisUrl = process.env.REDIS_URL || 'redis://127.0.0.1:6379';

// Connection options setup (BullMQ ki requirement)
const connectionOptions = {
  maxRetriesPerRequest: null, 
};

// 🔥 NAYA UPDATE: Upstash (rediss://) secure connection ke liye TLS config zaroori hai
if (redisUrl.startsWith('rediss://')) {
  connectionOptions.tls = { rejectUnauthorized: false };
}

// Redis Connection
const connection = new IORedis(redisUrl, connectionOptions);

// Create Queue
export const notificationQueue = new Queue('notifications', { connection });

// Background Worker jo Firebase ke through message bhejega
const worker = new Worker('notifications', async (job) => {
  // Controller se jo data aayega wo job.data mein hoga
  const { title, body, fcmToken, data } = job.data;
  
  if (!fcmToken) {
    throw new Error('FCM Token is missing. Cannot send notification.');
  }

  // Firebase Message Format
  const message = {
    notification: {
      title: title,
      body: body,
    },
    // Firestore/JSON fields mein null/undefined values allowed nahi hain, isliye keys ko string banaya hai
    data: data || {}, // Agar app open hone par kisi specific screen par bhejna ho (Deep linking)
    token: fcmToken,
  };

  try {
    // 🔥 NAYA UPDATE: Actual push notification send karna modular approach se
    const response = await getMessaging().send(message);
    console.log(`Successfully sent message to ${fcmToken}:`, response);
    return response;
  } catch (error) {
    console.error(`Error sending message to ${fcmToken}:`, error);
    throw error; // Throw error taaki BullMQ retry kar sake agar fail ho jaye
  }
}, { connection });

worker.on('completed', job => {
  console.log(`Notification Job ${job.id} completed!`);
});

worker.on('failed', (job, err) => {
  console.error(`Notification Job ${job.id} failed: ${err.message}`);
});

export default class AppError extends Error {
  constructor(message, statusCode) {
    super(message);
    this.statusCode = statusCode;
    this.status = `${statusCode}`.startsWith('4') ? 'fail' : 'error';
    this.isOperational = true;

    Error.captureStackTrace(this, this.constructor);
  }
}

export default (fn) => {
  return (req, res, next) => {
    fn(req, res, next).catch(next);
  };
};


// src/utils/createToken.js
import jwt from 'jsonwebtoken';

// 🔥 UPDATE: id ke sath sessionVersion bhi token me encode hoga
const signToken = (id, sessionVersion) => {
  return jwt.sign({ id, sessionVersion }, process.env.JWT_SECRET, {
    expiresIn: process.env.JWT_EXPIRES_IN || '7d',
  });
};

const createSendToken = (user, statusCode, res) => {
  // 🔥 UPDATE: yahan user.sessionVersion pass kiya
  const token = signToken(user._id, user.sessionVersion);

  user.password = undefined;

  res.status(statusCode).json({
    status: 'success',
    token,
    data: { user },
  });
};

export default createSendToken;

import express from 'express';
import cors from 'cors';
import helmet from 'helmet';
import morgan from 'morgan';
import rateLimit from 'express-rate-limit';
import globalErrorHandler from './middlewares/errorController.js';
import AppError from './utils/AppError.js';

import authRoutes from './routes/authRoutes.js';
import adminRoutes from './routes/adminRoutes.js';

import residentRoutes from './routes/residentRoutes.js'; 
import workerRoutes from './routes/workerRoutes.js';     
import visitorRoutes from './routes/visitorRoutes.js';
const app = express();

app.use(helmet());
app.use(cors());
app.use(express.json({ limit: '10kb' }));

if (process.env.NODE_ENV === 'development') {
  app.use(morgan('dev'));
}

const limiter = rateLimit({
  max: 100,
  windowMs: 15 * 60 * 1000,
  message: 'Too many requests from this IP, please try again in an hour!'
});
app.use('/api', limiter);

app.use('/api/auth', authRoutes);
app.use('/api/admin', adminRoutes);

app.use('/api/resident', residentRoutes); 
app.use('/api/worker', workerRoutes); 
app.use('/api/visitors', visitorRoutes);    

// 🔥 ULTIMATE FIXED FOR EXPRESS V5: Path string ko poori tarah hata kar sirf app.use() kiya.
// Jo bhi request upar ke kisi route se match nahi hogi, wo direct isme aakar 404 error ban jayegi.
app.use((req, res, next) => {
  next(new AppError(`Can't find ${req.originalUrl} on this server!`, 404));
});

app.use(globalErrorHandler);

export default app;

