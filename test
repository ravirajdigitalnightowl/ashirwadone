import multer from 'multer';
import { CloudinaryStorage } from 'multer-storage-cloudinary';
import cloudinary from '../config/cloudinary.js';
import AppError from '../utils/AppError.js';

const storage = new CloudinaryStorage({
  cloudinary: cloudinary,
  params: {
    folder: 'ashirwad_tickets', // Cloudinary mein is folder ke andar saari files jayengi
    allowed_formats: ['jpg', 'jpeg', 'png', 'mp4', 'mov'], // Images aur videos allow karein
    resource_type: 'auto', // 'auto' rakhne se ye apne aap detect kar lega ki photo hai ya video
  },
});

const upload = multer({
  storage: storage,
  limits: {
    fileSize: 50 * 1024 * 1024, // 50MB limit
  },
  fileFilter: (req, file, cb) => {
    if (file.mimetype.startsWith('image/') || file.mimetype.startsWith('video/')) {
      cb(null, true);
    } else {
      cb(new AppError('Only images and videos are allowed!', 400), false);
    }
  }
});

export default upload;


