export const assignTicket = catchAsync(async (req, res, next) => {
  const { workerId, adminNoteForWorker, adminNoteForResident } = req.body;

  const ticket = await Ticket.findById(req.params.id).populate('createdBy');
  if (!ticket) return next(new AppError('Ticket not found', 404));

  ticket.assignedTo = workerId;
  ticket.status = 'In-Progress';
  
  if (adminNoteForWorker) ticket.adminNoteForWorker = adminNoteForWorker;
  if (adminNoteForResident) ticket.adminNoteForResident = adminNoteForResident;

  ticket.timeline.push({
    title: 'Ticket Assigned to Staff',
    notes: 'Admin has reviewed and assigned this ticket.'
  });

  await ticket.save();

  const worker = await User.findById(workerId);

  // 1. Worker ko notification
  if (worker && worker.fcmToken) {
    notificationQueue.add('sendToWorker', {
      fcmToken: worker.fcmToken,
      title: 'New Task Assigned 🛠️',
      body: `Admin has assigned a new ticket to you. Tap to view.`,
      data: { type: 'TASK_ASSIGNED', ticketId: ticket._id.toString() }
    });
  }

  // 2. Resident ko notification
  if (ticket.createdBy && ticket.createdBy.fcmToken) {
    notificationQueue.add('sendToResident', {
      fcmToken: ticket.createdBy.fcmToken,
      title: 'Complaint Update 📢',
      body: `Your complaint has been assigned to ${worker.name}.`,
      data: { type: 'TICKET_UPDATED', ticketId: ticket._id.toString() }
    });
  }

  res.status(200).json({
    status: 'success',
    data: { ticket }
  });
});


