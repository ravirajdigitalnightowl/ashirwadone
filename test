    let query = { role: 'RESIDENT' };

    if (tower) {
      query.tower = { $regex: tower, $options: 'i' };
    }

    if (flatNo) {
      query.flatNo = { $regex: flatNo, $options: 'i' };
    }

    const residents = await User.find(query)
      .select('name tower flatNo phone')
      .limit(10); 

    res.status(200).json({
