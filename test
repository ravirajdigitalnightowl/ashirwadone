export const completeTask = catchAsync(async (req, res, next) => {
  const { workerNoteForAdmin, workerNoteForResident } = req.body;

  if (!workerNoteForAdmin || !workerNoteForResident) {
    return next(new AppError('Please provide both internal (admin) and external (resident) completion notes.', 400));
  }

  const ticket = await Ticket.findOne({ _id: req.params.id, assignedTo: req.user._id }).populate('createdBy');

  if (!ticket) {
    return next(new AppError('Task not found or not assigned to you', 404));
  }

  ticket.status = 'Resolved';
  ticket.workerNoteForAdmin = workerNoteForAdmin;
  ticket.workerNoteForResident = workerNoteForResident;
  
  // ✅ FIXED: Yahan se workerNoteForAdmin hata diya gaya hai.
  // Frontend apna logic lagakar khud workerNoteForResident dikha dega.
  ticket.timeline.push({
    title: 'Resolution & Verification',
    notes: `Task resolved successfully.` 
  });

  await ticket.save();

  if (ticket.createdBy && ticket.createdBy.fcmToken) {
    await notificationQueue.add('sendToResident', {
      fcmToken: ticket.createdBy.fcmToken,
      title: 'Ticket Resolved ✅',
      body: `Your ticket "${ticket.title}" has been resolved by our staff.`,
      data: { type: 'TICKET_UPDATED', ticketId: ticket._id.toString() }
    });
  }

  const admins = await User.find({ role: 'ADMIN' });
  admins.forEach(admin => {
    if (admin.fcmToken) {
      notificationQueue.add('sendToAdmin', {
        fcmToken: admin.fcmToken,
        title: 'Task Resolved ✅',
        body: `Staff has resolved the ticket: "${ticket.title}".`,
        data: { type: 'TICKET_UPDATED', ticketId: ticket._id.toString() }
      });
    }
  });

  res.status(200).json({
    status: 'success',
    message: 'Task marked as resolved',
    data: { ticket }
  });
});

